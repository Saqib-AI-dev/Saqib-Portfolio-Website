{
  "version": 2,
  "routes": [
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/style.css",  "dest": "/style.css"  },
    { "src": "/script.js",  "dest": "/script.js"  },
    { "src": "/data.js",    "dest": "/data.js"    },
    { "src": "/resume.pdf", "dest": "/resume.pdf" },
    { "src": "/profile.jpeg","dest": "/profile.jpeg"},
    { "src": "/",           "dest": "/index.html" },
    { "src": "/(.*)",       "dest": "/404.html", "status": 404 }
  ]
}
